# ============================================================
# Shared instance configuration
# Copy to .env.instance and fill in your values
# ============================================================

# --- Instance connection ---
SNC_HOST=your-instance.service-now.com
SNC_PROTOCOL=https
INSTANCE_NAME=                          # optional, derived from host if omitted
VERIFY_SSL=false

# --- Credentials ---
NW_USERNAME=your.username
NW_PASSWORD=your-password

# --- OAuth ---
OAUTH_CLIENT_ID=46e42d08770746f1802167828fcc6132
OAUTH_REDIRECT_URI=/api/snc/aiexauth/oauth/authorize

# --- Now Assist deployment ---
DEPLOYMENT_DOC_ID=c86a62e2c7022010099a308dc7c26022

# ============================================================
# QnA Eval specific
# ============================================================
# (uses the shared vars above; no extra config needed)

# ============================================================
# Document Generation specific
# ============================================================
DOC_GEN_INSTANCE=nwdemo
DOC_GEN_USERNAME=otto.eval
DOC_GEN_PASSWORD=
DOC_GEN_DEPLOYMENT_DOC_ID=
DOC_GEN_USERNAME_POOL=otto.eval,otto.eval1,otto.eval2,otto.eval3
